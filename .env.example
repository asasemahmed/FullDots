# FullDots: the UI opens in setup state until the model fields are configured.
HOST=127.0.0.1
PORT=4310
DATABASE_PATH=data/opendots.sqlite
# Keep OWNER_ID stable: it identifies the owner of local conversations.
OWNER_ID=opendots-owner
# npm run dev allows http://127.0.0.1:5173; override for a different exact origin.
# APP_ORIGIN=http://127.0.0.1:5173
# Required for an external HOST binding (24+ characters); enables local login too.
# OWNER_TOKEN=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Optional isolated read-only page reader used by search and research.
BROWSER_URL=http://127.0.0.1:4311
BROWSER_SECRET=
BROWSER_HOST=127.0.0.1
BROWSER_PORT=4311
# Use the same random 24+ character secret in app/browser. All redirects are blocked.
# Supply canonical public URLs. Use the separate browser container for isolation.

# Optional realtime speech; compute uses the same local conversation thread.
VOICE_API_KEY=
VOICE_MODEL=
VOICE_NAME=marin

# Optional persistent computers, one per Dot, using OpenBot services.
# See docs/COMPUTERS.md. Keep these two different random secrets on the server.
COMPUTER_SUPERVISOR_URL=
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
# Keep stable: the namespace identifies existing containers and persistent volumes.
COMPUTER_NAMESPACE=opendots
# COMPUTER_MEMORY_BYTES=2147483648
# COMPUTER_RUNTIME=runsc
# ENGINE_SOCKET=/var/run/docker.sock

# Web search: duckduckgo (default, no key) or disabled.
WEB_SEARCH_PROVIDER=duckduckgo

# Work limits. Leave unset for the defaults shown; times are in seconds.
# AGENT_TURN_TIMEOUT=90          # one Dot turn, including all its tool calls; 0 = no time limit
# AGENT_TURN_GRACE=20            # extra seconds a Dot gets to write its summary once the turn limit is reached
# AGENT_MAX_STEPS=8              # model steps per turn (1-1000); the last one is kept for a summary
# AGENT_MAX_TOKENS=2200          # tokens per model reply
# TASK_TIMEOUT=90                # one scheduled task run; 0 = no time limit
# COMPUTER_EXEC_MAX_TIMEOUT=60   # longest shell command (OpenBot max 600)
# COMPUTER_COMMAND_MAX_CHARS=8000
# COMPUTER_FILE_MAX_CHARS=100000 # largest file write (OpenBot max 1000000)
# COMPUTER_TYPE_MAX_CHARS=16000  # text typed into the browser at once
# COMPUTER_REQUEST_TIMEOUT=70    # raised automatically above the shell limit
# COMPUTER_RESPONSE_MAX_MB=4     # largest computer response, including screenshots
